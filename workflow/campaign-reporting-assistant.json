      ],
      "id": "7c1dd730-d72d-4d9f-a075-879269b5882d",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\nconst threshold = 20;\n\nreturn rows.map(item => {\n  const row = item.json;\n\n  const flags = [];\n\n  const metrics = [\n    \"spend\",\n    \"clicks\",\n    \"conversions\",\n    \"cpa\",\n    \"roas\",\n  ];\n\n  for (const metric of metrics) {\n    const change = row[`${metric}_change_percent`];\n\n    if (change === null || change === undefined ||\n        !Number.isFinite(Number(change))) {\n      continue;\n    }\n\n    if (Math.abs(Number(change)) >= threshold) {\n      let direction = Number(change) > 0\n        ? \"increased\"\n        : Number(change) < 0\n          ? \"decreased\"\n          : \"unchanged\";\n\n      let interpretation;\n\n      if (metric === \"cpa\") {\n        interpretation = Number(change) < 0\n          ? \"Improvement\"\n          : \"Potential Concern\";\n      } else if (metric === \"roas\" || metric === \"conversions\") {\n        interpretation = Number(change) > 0\n          ? \"Improvement\"\n          : \"Potential Concern\";\n      } else {\n        interpretation = \"Review\";\n      }\n\n      flags.push({\n        metric,\n        change_percent: Number(change),\n        direction,\n        interpretation,\n      });\n    }\n  }\n\n  return {\n    json: {\n      ...row,\n      change_threshold_percent: threshold,\n      flagged_change_count: flags.length,\n      change_flags: flags,\n      needs_attention: flags.some(\n        flag => flag.interpretation === \"Potential Concern\"\n      ),\n    },\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "id": "6ef805c5-67da-4842-896d-93f29cad70f5",
      "name": "Flag Major Changes"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst toNumber = (value) => {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  const number = Number(value);\n  return Number.isFinite(number) ? number : null;\n};\n\nreturn items\n  .filter((item) => {\n    const row = item.json;\n\n    const values = Object.values(row).map(value =>\n      String(value ?? \"\").trim().toLowerCase()\n    );\n\n    return !values.every(value =>\n      value === \"\" ||\n      value === \"empty\" ||\n      value === \"null\" ||\n      value === \"undefined\"\n    );\n  })\n  .map((item) => {\n    const row = item.json;\n\n   const campaign_name = String(row.campaign_name ?? \"\")\n    .trim()\n    .replace(/\\s+/g, \" \")\n    .toLowerCase()\n    .replace(/\\b\\w/g, char => char.toUpperCase());\n\n  const channelInput = String(row.channel ?? \"\")\n    .trim()\n    .toLowerCase();\n\n  let channel = channelInput;\n\n  if (channelInput === \"google ads\") {\n    channel = \"Google Ads\";\n  } else if (channelInput === \"meta ads\") {\n    channel = \"Meta Ads\";\n  }\n\n  const dateInput = String(row.date ?? \"\").trim();\n  let date = dateInput;\n\n  const match = dateInput.match(\n    /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/\n  );\n\n  if (match) {\n    const [, month, day, year] = match;\n\n    const normalizedDate =\n      `${year}-${month.padStart(2, \"0\")}-${day.padStart(2, \"0\")}`;\n\n    const parsedDate = new Date(`${normalizedDate}T00:00:00Z`);\n\n    if (\n      !Number.isNaN(parsedDate.getTime()) &&\n      parsedDate.toISOString().slice(0, 10) === normalizedDate\n    ) {\n      date = normalizedDate;\n    }\n  }\n\n  return {\n    json: {\n      campaign_name,\n      date,\n      channel,\n      currency: String(row.currency ?? \"\").trim().toUpperCase(),\n      impressions: toNumber(row.impressions),\n      clicks: toNumber(row.clicks),\n      spend: toNumber(row.spend),\n      conversions: toNumber(row.conversions),\n      conversion_value: toNumber(row.conversion_value)\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "9f41b4d3-07a6-4f62-8e2a-c16094afa2e5",
      "name": "Clean Data"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nfunction divide(numerator, denominator) {\n  if (\n    numerator === null ||\n    numerator === undefined ||\n    denominator === null ||\n    denominator === undefined ||\n    denominator === 0\n  ) {\n    return null;\n  }\n\n  return numerator / denominator;\n}\n\nreturn items.map((item) => {\n  const row = item.json;\n\n  const ctr = divide(row.clicks, row.impressions);\n  const cpc = divide(row.spend, row.clicks);\n  const cpm = divide(row.spend * 1000, row.impressions);\n  const conversion_rate = divide(row.conversions, row.clicks);\n  const cpa = divide(row.spend, row.conversions);\n  const roas = divide(row.conversion_value, row.spend);\n\n  return {\n    json: {\n      ...row,\n\n      ctr_percent: ctr === null ? null : Number((ctr * 100).toFixed(2)),\n      cpc: cpc === null ? null : Number(cpc.toFixed(2)),\n      cpm: cpm === null ? null : Number(cpm.toFixed(2)),\n      conversion_rate_percent:\n        conversion_rate === null\n          ? null\n          : Number((conversion_rate * 100).toFixed(2)),\n      cpa: cpa === null ? null : Number(cpa.toFixed(2)),\n      roas: roas === null ? null : Number(roas.toFixed(2))\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "39fca0f2-ef65-46fa-a360-0eecbe809d09",
      "name": "Calculate Performance Metrics"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst rows = items.map(item => item.json);\n\nconst previousDate = \"2026-10-05\";\nconst currentDate = \"2026-10-12\";\n\nconst metrics = [\"spend\", \"clicks\", \"conversions\", \"cpa\", \"roas\"];\n\nfunction percentChange(previous, current) {\n  if (previous === null || current === null ||\n      previous === undefined || current === undefined ||\n      previous === 0) {\n    return null;\n  }\n\n  return Number((((current - previous) / Math.abs(previous)) * 100).toFixed(2));\n}\n\nfunction numeric(value) {\n  return typeof value === \"number\" && Number.isFinite(value)\n    ? value\n    : null;\n}\n\nconst campaigns = new Map();\n\nfor (const row of rows) {\n  const key = `${row.channel}|${String(row.campaign_name).trim().toLowerCase()}`;\n\n  if (!campaigns.has(key)) {\n    campaigns.set(key, {\n      campaign_name: row.campaign_name,\n      channel: row.channel,\n      previous: null,\n      current: null\n    });\n  }\n\n  const campaign = campaigns.get(key);\n\n  if (row.date === previousDate) {\n    campaign.previous = row;\n  } else if (row.date === currentDate) {\n    campaign.current = row;\n  }\n}\n\nreturn Array.from(campaigns.values()).map(campaign => {\n  const previous = campaign.previous;\n  const current = campaign.current;\n\n  const output = {\n    campaign_name: campaign.campaign_name,\n    channel: campaign.channel,\n    previous_date: previousDate,\n    current_date: currentDate,\n    comparison_status: previous && current\n      ? \"Matched\"\n      : previous\n        ? \"Missing current period\"\n        : \"Missing previous period\"\n  };\n\n  for (const metric of metrics) {\n    const oldValue = previous ? numeric(previous[metric]) : null;\n    const newValue = current ? numeric(current[metric]) : null;\n\n    output[`${metric}_previous`] = oldValue;\n    output[`${metric}_current`] = newValue;\n\n    output[`${metric}_change`] =\n      oldValue === null || newValue === null\n        ? null\n        : Number((newValue - oldValue).toFixed(2));\n\n    output[`${metric}_change_percent`] =\n      oldValue === null || newValue === null\n        ? null\n        : percentChange(oldValue, newValue);\n  }\n\n  return { json: output };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "id": "40d5a694-bd9b-4d21-b5e9-4e355d100508",
      "name": "Comparison of Two Reporting Periods"
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\nconst threshold = 20;\n\nreturn rows.map(item => {\n  const row = item.json;\n  const flags = [];\n\n  const metrics = [\n    \"spend\",\n    \"clicks\",\n    \"conversions\",\n    \"cpa\",\n    \"roas\",\n  ];\n\n  for (const metric of metrics) {\n    const change = row[`${metric}_change_percent`];\n\n    if (\n      change === null ||\n      change === undefined ||\n      change === \"\" ||\n      !Number.isFinite(Number(change))\n    ) {\n      continue;\n    }\n\n    const value = Number(change);\n\n    if (Math.abs(value) >= threshold) {\n      const direction =\n        value > 0 ? \"increased\" :\n        value < 0 ? \"decreased\" :\n        \"unchanged\";\n\n      let interpretation;\n\n      if (metric === \"cpa\") {\n        interpretation =\n          value < 0 ? \"Improvement\" : \"Potential Concern\";\n      } else if (metric === \"roas\" || metric === \"conversions\") {\n        interpretation =\n          value > 0 ? \"Improvement\" : \"Potential Concern\";\n      } else {\n        interpretation = \"Review\";\n      }\n\n      flags.push({\n        metric,\n        change_percent: value,\n        direction,\n        interpretation,\n      });\n    }\n  }\n\n  const spendChange = Number(row.spend_change_percent);\n\n  const spendReviewRequired =\n    row.spend_change_percent !== null &&\n    row.spend_change_percent !== undefined &&\n    row.spend_change_percent !== \"\" &&\n    Number.isFinite(spendChange) &&\n    spendChange >= threshold;\n\n  return {\n    json: {\n      ...row,\n      change_threshold_percent: threshold,\n      flagged_change_count: flags.length,\n      change_flags: flags,\n      needs_attention:\n      flags.some(\n      flag => flag.interpretation === \"Potential Concern\"\n      ) || spendReviewRequired,\n      spend_review_required: spendReviewRequired,\n    },\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ],
