    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nif (items.length === 0) {\n  throw new Error(\"Validation failed: No campaign data received.\");\n}\n\nconst requiredFields = [\n  \"campaign_name\",\n  \"date\",\n  \"channel\",\n  \"currency\",\n  \"impressions\",\n  \"clicks\",\n  \"spend\",\n  \"conversions\",\n  \"conversion_value\",\n];\n\nconst numericFields = [\n  \"impressions\",\n  \"clicks\",\n  \"spend\",\n  \"conversions\",\n  \"conversion_value\",\n];\n\nconst errors = [];\n\nitems.forEach((item, index) => {\n  const row = item.json;\n  const rowNumber = index + 1;\n\n  for (const field of requiredFields) {\n  const value = row[field];\n\n  if (\n    value === undefined ||\n    value === null ||\n    String(value).trim() === \"\" ||\n    [\"empty\", \"null\", \"undefined\", \"n/a\"].includes(\n      String(value).trim().toLowerCase()\n    )\n  ) {\n    errors.push(`Row ${rowNumber}: Missing or invalid ${field}`);\n  }\n}\n\n  for (const field of numericFields) {\n    const value = row[field];\n\n    if (\n      value === null ||\n      value === undefined ||\n      value === \"\" ||\n      !Number.isFinite(Number(value)) ||\n      Number(value) < 0\n    ) {\n      errors.push(`Row ${rowNumber}: Invalid ${field}`);\n    }\n  }\n\n  if (row.date) {\n    const date = String(row.date).trim();\n\n    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date)) {\n      errors.push(`Row ${rowNumber}: Date must use YYYY-MM-DD`);\n    } else {\n      const parsed = new Date(`${date}T00:00:00Z`);\n\n      if (\n        Number.isNaN(parsed.getTime()) ||\n        parsed.toISOString().slice(0, 10) !== date\n      ) {\n        errors.push(`Row ${rowNumber}: Invalid calendar date`);\n      }\n    }\n  }\n});\n\nif (errors.length > 0) {\n  throw new Error(\n    `Campaign data validation failed:\\n${errors.join(\"\\n\")}`\n  );\n}\n\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    validation_passed: true,\n  },\n}));\n"
      },
